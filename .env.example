# Секреты сайта Andrey AI Lab. Файл локальный — в git не коммитить.

# Flask: ключ сессий (любая длинная случайная строка)
SECRET_KEY=

# Админ-панель (/admin/)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Чат-ассистент (GigaChat, developers.sber.ru).
# Вариант 1: Authorization key (base64) из личного кабинета:
GIGACHAT_CREDENTIALS=
# Вариант 2: пара client_id/client_secret — ключ соберётся автоматически:
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Для юридических лиц смените scope на GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
